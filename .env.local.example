# Neon Postgres — set in Vercel env; locally copy from Neon dashboard
# Leave empty to keep using local SQLite (data/synthetic.db) for hackathon demo
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/reviveai?sslmode=require

# Batch execution token — required by POST /api/batch/run
# Server side: BATCH_TOKEN. Client dashboard: NEXT_PUBLIC_BATCH_TOKEN (must match).
BATCH_TOKEN=reviveai-demo-token
NEXT_PUBLIC_BATCH_TOKEN=reviveai-demo-token

# Razorpay Test Mode credentials
# Create a test account at https://dashboard.razorpay.com — keys are under Settings → API Keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_test_key_secret_here
