# ─── Database (Neon Postgres) ────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/reviveai?sslmode=require

# ─── Auth.js ─────────────────────────────────────────────────────────────────
AUTH_SECRET=          # Generate with: openssl rand -base64 32
AUTH_URL=http://localhost:3000

# Google OAuth (optional — create at https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Batch API Protection (production) ───────────────────────────────────────
# Generate a strong token: openssl rand -base64 32
# Rotate quarterly: update Vercel env BATCH_TOKEN + redeploy, revoke old token immediately.
# Demo fallback "reviveai-demo-token" is hard-coded for local/tests only — never use in production.
BATCH_TOKEN=change-me-generate-with-openssl-rand-base64-32
NEXT_PUBLIC_BATCH_TOKEN=change-me-must-match-BATCH_TOKEN

# ─── Audit Retention (RBI immutability) ──────────────────────────────────────
# Audit log is append-only with run_id per batch. Retention: 7 years (RBI guideline).
# Never run DELETE FROM audit_log in production — history is preserved via run_id filtering.
# Backups: daily pg_dump to S3 (Neon branching) — see docs/retention-policy.md
