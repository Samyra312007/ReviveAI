# ─── Database (Neon Postgres) ────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/reviveai?sslmode=require

# ─── Auth.js ─────────────────────────────────────────────────────────────────
AUTH_SECRET=          # Generate with: openssl rand -base64 32
AUTH_URL=http://localhost:3000

# Google OAuth (optional — create at https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Razorpay (Test Mode is free — used for webhooks + data import) ─────────
# Optional — when not set, the agent runs in simulation mode.
RAZORPAY_KEY_ID=rzp_test_xxxxx
RAZORPAY_KEY_SECRET=xxxxx

# ─── Notification providers (all optional — simulated when not set) ─────────
# WhatsApp Business Cloud API (https://developers.facebook.com/docs/whatsapp/cloud-api)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=      # any random string you choose for webhook verification

# Resend transactional email (https://resend.com — 100 free emails/day)
RESEND_API_KEY=
RESEND_FROM_EMAIL=ReviveAI <recovery@yourdomain.com>

# ─── Alerts ──────────────────────────────────────────────────────────────────
ALERT_EMAIL=                # where batch completion/failure emails go
SLACK_WEBHOOK_URL=          # incoming webhook for batch alerts (optional)

# ─── Scheduled processing (Vercel Cron) ─────────────────────────────────────
CRON_SECRET=                # shared secret; Vercel sends it as "Authorization: Bearer <CRON_SECRET>"
                            # Generate with: openssl rand -base64 32

# ─── Observability ───────────────────────────────────────────────────────────
# Sentry DSN (optional — leave empty to disable)
NEXT_PUBLIC_SENTRY_DSN=

# Log level: debug | info | warn | error (default: info in prod, debug in dev)
LOG_LEVEL=

# ─── Audit Retention (RBI immutability) ──────────────────────────────────────
# Audit log is append-only with run_id per batch. Retention: 7 years (RBI guideline).
# Never run DELETE FROM audit_log in production — history is preserved via run_id filtering.
# Backups: daily pg_dump to S3 (Neon branching) — see docs/retention-policy.md